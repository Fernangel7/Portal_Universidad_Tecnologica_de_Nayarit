<!DOCTYPE html>
<html lang="es" class="scroll-smooth">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ECECUT - Educación Continua - <%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=PT+Sans:wght@400;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            body: ['Inter', 'sans-serif'],
            headline: ['PT Sans', 'sans-serif'],
          },
          colors: {
            background: 'hsl(165 60% 97%)',
            foreground: 'hsl(171 80% 10%)',
            card: 'hsl(165 60% 97%)',
            'card-foreground': 'hsl(171 80% 10%)',
            primary: 'hsl(171 95% 27%)',
            'primary-foreground': 'hsl(171 25% 95%)',
            secondary: 'hsl(169 53% 90%)',
            'secondary-foreground': 'hsl(171 95% 27%)',
            muted: 'hsl(169 53% 94%)',
            'muted-foreground': 'hsl(171 40% 30%)',
            accent: 'hsl(169 53% 41%)',
            'accent-foreground': 'hsl(171 25% 98%)',
            border: 'hsl(171 20% 88%)',
          },
        },
      },
    }
  </script>
</head>

<body class="font-body antialiased bg-background text-foreground">
  <%- include("./templates/header.ejs", { navigationLinks: navigationLinks, title: title }) %>

  <%- include("./templates/page_header.ejs", { 
    pageTitle: "ECECUT - Educación Continua",
    pageDescription: "Cursos, diplomados y certificaciones para impulsar tu desarrollo profesional",
    breadcrumbs: [
      { title: "Inicio", href: "/" },
      { title: "Servicios", href: "#" },
      { title: "ECECUT", href: null }
    ]
  }) %>

  <section class="py-16 md:py-24">
    <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      
      <div class="prose prose-lg max-w-none mb-12">
        <p class="text-lg text-muted-foreground leading-relaxed">
          El Espacio Común de Educación Superior Tecnológica de la Universidad Tecnológica (ECECUT) 
          ofrece programas de educación continua, capacitación y actualización profesional para egresados, 
          profesionistas y público en general interesado en fortalecer sus competencias.
        </p>
      </div>

      <div class="mb-16">
        <h2 class="font-headline text-3xl font-bold tracking-tight mb-8">Programas Disponibles</h2>
        <div class="grid gap-8 md:grid-cols-3">
          
          <div class="rounded-lg border bg-card text-card-foreground shadow-sm p-6 hover:shadow-lg transition-shadow">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary/10">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 text-primary">
                <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>
              </svg>
            </div>
            <h3 class="font-headline text-xl font-semibold mb-2">Cursos de Capacitación</h3>
            <p class="text-muted-foreground">
              Programas cortos enfocados en habilidades técnicas y competencias específicas del sector productivo.
            </p>
          </div>

          <div class="rounded-lg border bg-card text-card-foreground shadow-sm p-6 hover:shadow-lg transition-shadow">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary/10">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 text-primary">
                <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
                <line x1="16" x2="16" y1="2" y2="6"/>
                <line x1="8" x2="8" y1="2" y2="6"/>
                <line x1="3" x2="21" y1="10" y2="10"/>
              </svg>
            </div>
            <h3 class="font-headline text-xl font-semibold mb-2">Diplomados</h3>
            <p class="text-muted-foreground">
              Programas de especialización con mayor profundidad en áreas estratégicas de desarrollo profesional.
            </p>
          </div>

          <div class="rounded-lg border bg-card text-card-foreground shadow-sm p-6 hover:shadow-lg transition-shadow">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-primary/10">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 text-primary">
                <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
                <polyline points="14 2 14 8 20 8"/>
                <path d="m10 13 2 2 4-4"/>
              </svg>
            </div>
            <h3 class="font-headline text-xl font-semibold mb-2">Certificaciones</h3>
            <p class="text-muted-foreground">
              Validación oficial de competencias laborales reconocidas por el sector productivo y educativo.
            </p>
          </div>

        </div>
      </div>

      <div class="bg-secondary/50 rounded-lg p-8 md:p-12 mb-16">
        <h2 class="font-headline text-3xl font-bold tracking-tight mb-8 text-center">Áreas de Formación</h2>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          <div class="flex gap-3 items-start">
            <div class="flex-shrink-0 mt-1">
              <div class="h-2 w-2 rounded-full bg-primary"></div>
            </div>
            <div>
              <h4 class="font-semibold mb-1">Tecnologías de la Información</h4>
              <p class="text-sm text-muted-foreground">Programación, bases de datos, ciberseguridad</p>
            </div>
          </div>
          <div class="flex gap-3 items-start">
            <div class="flex-shrink-0 mt-1">
              <div class="h-2 w-2 rounded-full bg-primary"></div>
            </div>
            <div>
              <h4 class="font-semibold mb-1">Administración y Negocios</h4>
              <p class="text-sm text-muted-foreground">Gestión empresarial, finanzas, marketing</p>
            </div>
          </div>
          <div class="flex gap-3 items-start">
            <div class="flex-shrink-0 mt-1">
              <div class="h-2 w-2 rounded-full bg-primary"></div>
            </div>
            <div>
              <h4 class="font-semibold mb-1">Manufactura y Automatización</h4>
              <p class="text-sm text-muted-foreground">Procesos industriales, robótica, mecatrónica</p>
            </div>
          </div>
          <div class="flex gap-3 items-start">
            <div class="flex-shrink-0 mt-1">
              <div class="h-2 w-2 rounded-full bg-primary"></div>
            </div>
            <div>
              <h4 class="font-semibold mb-1">Desarrollo Sustentable</h4>
              <p class="text-sm text-muted-foreground">Energías renovables, medio ambiente</p>
            </div>
          </div>
          <div class="flex gap-3 items-start">
            <div class="flex-shrink-0 mt-1">
              <div class="h-2 w-2 rounded-full bg-primary"></div>
            </div>
            <div>
              <h4 class="font-semibold mb-1">Turismo y Gastronomía</h4>
              <p class="text-sm text-muted-foreground">Gestión turística, innovación gastronómica</p>
            </div>
          </div>
          <div class="flex gap-3 items-start">
            <div class="flex-shrink-0 mt-1">
              <div class="h-2 w-2 rounded-full bg-primary"></div>
            </div>
            <div>
              <h4 class="font-semibold mb-1">Idiomas y Comunicación</h4>
              <p class="text-sm text-muted-foreground">Lenguas extranjeras, comunicación efectiva</p>
            </div>
          </div>
        </div>
      </div>

      <div class="text-center bg-gradient-to-br from-primary to-accent rounded-lg p-8 md:p-12">
        <h2 class="font-headline text-3xl font-bold tracking-tight text-primary-foreground mb-4">
          Impulsa tu Carrera Profesional
        </h2>
        <p class="text-lg text-primary-foreground/90 mb-8 max-w-2xl mx-auto">
          Mantente actualizado y competitivo con nuestros programas de educación continua.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="mailto:ececut@utnay.edu.mx" class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium h-11 px-8 bg-background text-foreground hover:bg-background/90">
            Más Información
          </a>
          <a href="tel:+523112119800" class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium h-11 px-8 border-2 border-primary-foreground text-primary-foreground hover:bg-primary-foreground/10">
            Contactar
          </a>
        </div>
      </div>

    </div>
  </section>

  <%- include("./templates/footer.ejs", {title: title}) %>

</body>
</html>
