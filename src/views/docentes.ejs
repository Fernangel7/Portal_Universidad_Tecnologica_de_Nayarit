<!DOCTYPE html>
<html lang="es" class="scroll-smooth">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Docentes - Universidad Tecnológica</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossOrigin="anonymous" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=PT+Sans:wght@400;700&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com?plugins=forms,typography,aspect-ratio,line-clamp"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            'body': ['Inter', 'sans-serif'],
            'headline': ['PT Sans', 'sans-serif'],
          },
          colors: {
            background: 'hsl(165 60% 97%)',
            foreground: 'hsl(171 80% 10%)',
            card: {
              DEFAULT: 'hsl(165 60% 97%)',
              'foreground': 'hsl(171 80% 10%)',
            },
            popover: {
              DEFAULT: 'hsl(165 60% 97%)',
              'foreground': 'hsl(171 80% 10%)',
            },
            primary: {
              DEFAULT: 'hsl(171 95% 27%)',
              'foreground': 'hsl(171 25% 95%)',
            },
            secondary: {
              DEFAULT: 'hsl(169 53% 90%)',
              'foreground': 'hsl(171 95% 27%)',
            },
            muted: {
              DEFAULT: 'hsl(169 53% 94%)',
              'foreground': 'hsl(171 40% 30%)',
            },
            accent: {
              DEFAULT: 'hsl(169 53% 41%)',
              'foreground': 'hsl(171 25% 98%)',
            },
            destructive: {
              DEFAULT: 'hsl(0 84.2% 60.2%)',
              'foreground': 'hsl(0 0% 98%)',
            },
            border: 'hsl(171 20% 88%)',
            input: 'hsl(171 20% 88%)',
            ring: 'hsl(171 95% 27%)',
          },
          borderRadius: {
            lg: '0.5rem',
            md: 'calc(0.5rem - 2px)',
            sm: 'calc(0.5rem - 4px)',
          },
        }
      }
    }
  </script>
</head>

<body class="font-body antialiased">
  <div class="flex min-h-screen flex-col">
    <%- include('templates/header.ejs', navigationLinks); %>
    <main class="flex-1">
      <!-- Hero Section -->
      <section class="relative h-80 w-full">
        <img src="https://images.unsplash.com/photo-1511629091441-ee46146481b6?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3NDE5ODJ8MHwxfHNlYXJjaHwyfHxwcm9mZXNzb3IlMjBjbGFzc3Jvb218ZW58MHx8fHwxNzU5NDI2NjAyfDA&ixlib=rb-4.1.0&q=80&w=1080" alt="Professor lecturing in a modern classroom" class="absolute inset-0 h-full w-full object-cover" data-ai-hint="professor classroom" />
        <div class="absolute inset-0 bg-black/60"></div>
        <div class="container relative z-10 mx-auto flex h-full max-w-7xl flex-col items-center justify-center text-center text-white">
          <h1 class="font-headline text-4xl font-bold md:text-5xl">
            Nuestro Claustro
          </h1>
          <p class="mt-4 max-w-2xl text-lg text-primary-foreground/90">
            Expertos y líderes que inspiran a la próxima generación.
          </p>
        </div>
      </section>

      <!-- Content Section -->
      <section class="py-16 md:py-24">
        <div class="container mx-auto max-w-7xl px-4">
          <div class="text-center mb-12">
            <h2 class="font-headline text-3xl font-bold tracking-tight">Conoce a Nuestros Docentes</h2>
            <p class="mt-4 text-lg text-gray-600 max-w-3xl mx-auto">
              Contamos con un cuerpo docente de excelencia, con amplia experiencia profesional y académica, comprometido con la formación integral de nuestros estudiantes.
            </p>
          </div>

          <% if (teachers && teachers.length > 0) { %>
          <!-- Teachers Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <% teachers.forEach(teacher => { %>
            <div class="bg-card rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-shadow duration-300 border border-border">
              <div class="aspect-w-3 aspect-h-2">
                <img src="<%= teacher.imageUrl || 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=400&h=400&fit=crop' %>" alt="<%= teacher.nombre %>" class="w-full h-64 object-cover" />
              </div>
              <div class="p-6">
                <h3 class="font-headline text-xl font-bold text-foreground">
                  <%= teacher.nombre %>
                </h3>
                <p class="text-sm text-muted-foreground mt-1">
                  <%= teacher.cargo || 'Docente' %>
                </p>
                <% if (teacher.departamento) { %>
                <p class="text-sm text-primary font-medium mt-1">
                  <%= teacher.departamento %>
                </p>
                <% } %>
                <% if (teacher.shortBio) { %>
                <p class="mt-3 text-sm text-gray-600 line-clamp-3">
                  <%= teacher.shortBio %>
                </p>
                <% } %>
                <a href="/docentes/<%= teacher.slug %>" class="mt-4 inline-flex items-center text-sm font-medium text-primary hover:text-accent transition-colors">
                  Ver Perfil
                  <svg xmlns="http://www.w3.org/2000/svg" class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>
            <% }); %>
          </div>
          <% } else { %>
          <!-- Empty State -->
          <div class="text-center py-12">
            <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto h-16 w-16 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            <p class="mt-4 text-lg text-gray-600">
              No hay docentes registrados en este momento.
            </p>
          </div>
          <% } %>
        </div>
      </section>
    </main>
    <%- include('templates/footer.ejs'); %>
  </div>
</body>

</html>