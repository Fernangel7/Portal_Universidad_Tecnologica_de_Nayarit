<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Noticias - <%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=PT+Sans:wght@400;700&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com?plugins=forms,typography,aspect-ratio,line-clamp"></script>
</head>
<body class="font-body antialiased bg-white">
  <div class="flex min-h-screen flex-col">
    <%- include('templates/header.ejs', navigationLinks); %>
    <main class="flex-1">
      <section class="relative h-72 w-full">
        <img src="https://images.unsplash.com/photo-1523050854058-8df90110c9f1?auto=format&fit=crop&w=1400&q=80" class="absolute inset-0 h-full w-full object-cover" alt="Campus" />
        <div class="absolute inset-0 bg-black/55"></div>
        <div class="relative z-10 flex h-full items-center justify-center flex-col text-center text-white px-4">
          <h1 class="font-headline text-4xl md:text-5xl font-bold">Noticias</h1>
          <p class="mt-3 max-w-2xl text-primary-foreground/90">Actualizaciones y comunicados oficiales.</p>
        </div>
      </section>
      <section class="py-12 md:py-16">
        <div class="mx-auto max-w-6xl px-4">
          <div class="grid gap-8 md:grid-cols-3">
            <% if (news && news.length > 0) { %>
              <% news.forEach(function(n){ %>
                <a href="/noticias/<%= n.slug %>" class="group rounded-lg border bg-white shadow-sm hover:shadow-md transition overflow-hidden flex flex-col">
                  <div class="h-40 w-full overflow-hidden">
                    <img src="<%= n.imageUrl || 'https://picsum.photos/seed/noticia-'+n.slug+'/400/200' %>" class="h-full w-full object-cover group-hover:scale-105 transition" />
                  </div>
                  <div class="p-4 flex flex-col gap-2">
                    <h3 class="font-headline font-semibold text-lg line-clamp-2"><%= n.titulo %></h3>
                    <p class="text-sm text-gray-600 line-clamp-3"><%= n.resumen || '' %></p>
                    <div class="mt-auto text-xs text-gray-500"><%= n.publicada_en ? new Date(n.publicada_en).toLocaleDateString('es-MX') : '' %></div>
                  </div>
                </a>
              <% }) %>
            <% } else { %>
              <div class="col-span-full text-center text-gray-600 py-16">No hay noticias disponibles.</div>
            <% } %>
          </div>
        </div>
      </section>
    </main>
    <%- include('templates/footer.ejs'); %>
  </div>
</body>
</html>
