<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Oferta Educativa - Universidad Tecnológica</title>
        <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=PT+Sans:wght@400;700&display=swap" rel="stylesheet" />
        <script>
            tailwind.config = {
                theme: {
                    extend: {
                        fontFamily: {
                            body: ['Inter', 'sans-serif'],
                            headline: ['PT Sans', 'sans-serif'],
                        },
                        colors: {
                            background: 'hsl(165 60% 97%)',
                            foreground: 'hsl(171 80% 10%)',
                            card: 'hsl(165 60% 97%)',
                            'card-foreground': 'hsl(171 80% 10%)',
                            popover: 'hsl(165 60% 97%)',
                            'popover-foreground': 'hsl(171 80% 10%)',
                            primary: 'hsl(171 95% 27%)',
                            'primary-foreground': 'hsl(171 25% 95%)',
                            secondary: 'hsl(169 53% 90%)',
                            'secondary-foreground': 'hsl(171 95% 27%)',
                            muted: 'hsl(169 53% 94%)',
                            'muted-foreground': 'hsl(171 40% 30%)',
                            accent: 'hsl(169 53% 41%)',
                            'accent-foreground': 'hsl(171 25% 98%)',
                            destructive: 'hsl(0 84.2% 60.2%)',
                            'destructive-foreground': 'hsl(0 0% 98%)',
                            border: 'hsl(171 20% 88%)',
                            input: 'hsl(171 20% 88%)',
                            ring: 'hsl(171 95% 27%)',
                        },
                        borderRadius: {
                            lg: '0.5rem',
                            md: 'calc(0.5rem - 2px)',
                            sm: 'calc(0.5rem - 4px)',
                        },
                    },
                },
            }
        </script>
</head>
<body class="font-body antialiased bg-background text-foreground">
    <%- include("./templates/header.ejs", { navigationLinks: navigationLinks, title: title }) %>

    <main>
        <!-- Hero Section -->
        <section class="relative h-80 w-full">
            <img src="<%= allProgramsHero.imageUrl %>" alt="<%= allProgramsHero.description %>" class="absolute inset-0 h-full w-full object-cover" />
            <div class="absolute inset-0 bg-black/60"></div>
            <div class="container relative z-10 mx-auto flex h-full max-w-7xl flex-col items-center justify-center text-center text-white">
                <h1 class="font-headline text-4xl font-bold md:text-5xl">Oferta Educativa</h1>
                <p class="mt-4 max-w-2xl text-lg text-primary-foreground/90">
                    Explora todos nuestros programas y encuentra tu vocación.
                </p>
            </div>
        </section>

        <!-- Programs Grid Section -->
        <section class="py-16 md:py-24">
            <div class="container mx-auto max-w-7xl">
                <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
                    <% programs.forEach(program => { %>
                        <div class="overflow-hidden rounded-lg border bg-card text-card-foreground shadow-sm transition-shadow hover:shadow-lg flex flex-col">
                            <div class="p-0">
                                <% if (program.programImage) { %>
                                <img src="<%= program.programImage.imageUrl %>" alt="<%= program.programImage.description %>" width="600" height="400" class="h-48 w-full object-cover" />
                                <% } %>
                            </div>
                            <div class="p-6 flex flex-col flex-1">
                                <h3 class="font-headline text-xl font-semibold"><%= program.name %></h3>
                                <% if (program.shortDescription) { %><p class="mt-2 text-muted-foreground"><%= program.shortDescription %></p><% } %>
                                <% if (program.programDetails) { %><p class="mt-2 text-sm text-muted-foreground line-clamp-4"><%= program.programDetails %></p><% } %>
                                <% if (program.workField) { %><p class="mt-3 text-xs text-foreground/70"><span class="font-medium">Campo Laboral:</span> <%= program.workField.substring(0,180) %><%= program.workField.length>180?'...':'' %></p><% } %>
                                <% if (program.competencies) { %><p class="mt-2 text-xs text-foreground/70"><span class="font-medium">Competencias:</span> <%= program.competencies.substring(0,180) %><%= program.competencies.length>180?'...':'' %></p><% } %>
                                <% if (program.studyPlan && program.studyPlan.length>0) { %><p class="mt-2 text-xs text-foreground/60">Plan de estudio: <%= program.studyPlan.length %> cuatrimestres</p><% } %>
                                <div class="mt-4 flex gap-2">
                                    <a href="/carreras/<%= program.slug %>" class="inline-flex items-center gap-2 text-sm font-medium text-primary underline-offset-4 hover:underline">
                                        Conocer más
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        </section>
    </main>

    <%- include("./templates/footer.ejs", { title: title }) %>
</body>
</html>
