<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=PT+Sans:wght@400;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --background: 165 60% 97%;
      --foreground: 171 80% 10%;
      --card: 165 60% 97%;
      --card-foreground: 171 80% 10%;
      --popover: 165 60% 97%;
      --popover-foreground: 171 80% 10%;
      --primary: 171 95% 27%;
      --primary-foreground: 171 25% 95%;
      --secondary: 169 53% 90%;
      --secondary-foreground: 171 95% 27%;
      --muted: 169 53% 94%;
      --muted-foreground: 171 40% 30%;
      --accent: 169 53% 41%;
      --accent-foreground: 171 25% 98%;
      --destructive: 0 84.2% 60.2%;
      --destructive-foreground: 0 0% 98%;
      --border: 171 20% 88%;
      --input: 171 20% 88%;
      --ring: 171 95% 27%;
      --radius: 0.5rem;
    }
    body { font-family: 'Inter', sans-serif; background-color: hsl(var(--muted) / 0.4); }
    .font-headline { font-family: 'PT Sans', sans-serif; }
    .bg-background { background-color: hsl(var(--background)); }
    .bg-card { background-color: hsl(var(--card)); }
    .text-card-foreground { color: hsl(var(--card-foreground)); }
    .border { border-width: 1px; }
    .border-border { border-color: hsl(var(--border)); }
    .badge-secondary { background-color: hsl(var(--secondary)); color: hsl(var(--secondary-foreground)); }
  </style>
</head>
<body class="antialiased">
  <div class="relative min-h-screen w-full md:flex">
    <%- include('./templates/left_menu.ejs', { hovered: 7 }) %>

    <div class="flex flex-col flex-1">
      <header class="flex h-14 items-center gap-4 border-b bg-background px-4 md:px-6">
        <button id="mobile-menu-trigger" class="md:hidden p-2 -ml-2 text-muted-foreground">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
            <line x1="4" x2="20" y1="12" y2="12" />
            <line x1="4" x2="20" y1="6" y2="6" />
            <line x1="4" x2="20" y1="18" y2="18" />
          </svg>
          <span class="sr-only">Toggle Menu</span>
        </button>
        <div class="flex-1"><h1 class="font-semibold text-lg">Pre-registros de Aspirantes</h1></div>
        <%- include('./templates/dropdown_user.ejs') %>
      </header>

      <main class="grid flex-1 items-start gap-4 p-4 sm:px-6 md:gap-8">
        <div class="bg-card rounded-lg border shadow-sm">
          <div class="flex flex-col sm:flex-row items-center justify-between p-6">
            <div>
              <h3 class="text-xl font-headline font-semibold">Listado de Pre-registros</h3>
              <p class="text-sm text-muted-foreground">Prefichas generadas por aspirantes.</p>
            </div>
            <div class="flex items-center gap-2 mt-4 sm:mt-0">
              <div class="relative">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-2.5 top-2.5 h-4 w-4 text-muted-foreground">
                  <circle cx="11" cy="11" r="8" />
                  <path d="m21 21-4.3-4.3" />
                </svg>
                <input type="search" id="searchInput" placeholder="Buscar por preficha, nombre o correo..." class="pl-8 w-full sm:w-72 h-9 rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">
              </div>
            </div>
          </div>
          <div class="p-0">
            <div class="overflow-x-auto overflow-visible pb-16">
              <table class="w-full text-sm">
                <thead class="bg-muted/50">
                  <tr class="border-b">
                    <th class="p-4 text-left font-medium text-muted-foreground">Preficha</th>
                    <th class="p-4 text-left font-medium text-muted-foreground">Nombre</th>
                    <th class="p-4 text-left font-medium text-muted-foreground hidden md:table-cell">Correo</th>
                    <th class="p-4 text-left font-medium text-muted-foreground hidden lg:table-cell">Teléfono</th>
                    <th class="p-4 text-left font-medium text-muted-foreground hidden md:table-cell">Carrera</th>
                    <th class="p-4 text-left font-medium text-muted-foreground hidden xl:table-cell">Escuela</th>
                    <th class="p-4 text-left font-medium text-muted-foreground hidden lg:table-cell">Fecha</th>
                    <th class="p-4 text-right font-medium text-muted-foreground">Acciones</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-border">
                  <% if (aspirantes && aspirantes.length > 0) { %>
                    <% aspirantes.forEach(function(a){ %>
                      <tr class="hover:bg-muted/30 cursor-pointer" onclick="toggleDetails('<%= a.UUID %>')">
                        <td class="p-4 font-mono text-xs"><%= a.Preficha %></td>
                        <td class="p-4 font-medium">
                          <%= a.Nombre %> <%= a.Apellidos || '' %>
                          <% if (a.CURP) { %>
                            <div class="text-xs text-muted-foreground mt-0.5"><%= a.CURP %></div>
                          <% } %>
                        </td>
                        <td class="p-4 text-muted-foreground hidden md:table-cell"><%= a.Correo || '-' %></td>
                        <td class="p-4 text-muted-foreground hidden lg:table-cell"><%= a.Telefono || '-' %></td>
                        <td class="p-4 text-muted-foreground hidden md:table-cell"><%= a.CarreraSlug || '-' %></td>
                        <td class="p-4 text-muted-foreground text-xs hidden xl:table-cell">
                          <%= (a.EscuelaProcedencia && a.EscuelaProcedencia.Nombre) ? a.EscuelaProcedencia.Nombre : '-' %>
                        </td>
                        <td class="p-4 text-muted-foreground hidden lg:table-cell text-xs"><%= (new Date(a.Created_at)).toLocaleDateString('es-MX') %></td>
                        <td class="p-4 text-right">
                          <% if (a.Correo) { %>
                            <a href="mailto:<%= a.Correo %>?subject=Contacto%20Pre-registro%20UTN&body=<%= encodeURIComponent('Hola ' + a.Nombre + ' ' + (a.Apellidos || '') + '\n\nTe contactamos respecto a tu pre-registro (Preficha: ' + a.Preficha + ').' + (a.CarreraSlug ? ('\nCarrera de interés: ' + a.CarreraSlug) : '') + '\n\nSi necesitas actualizar tus datos, puedes iniciar sesión en el portal de aspirantes.\n\nAtentamente,\nAdmisiones UTN') %>" class="inline-flex items-center gap-2 px-3 py-1.5 border border-input bg-background hover:bg-accent hover:text-accent-foreground rounded-md text-sm" onclick="event.stopPropagation()">
                              Contactar
                            </a>
                          <% } else { %>
                            <span class="text-sm text-muted-foreground">—</span>
                          <% } %>
                        </td>
                      </tr>
                      <tr id="details-<%= a.UUID %>" class="hidden bg-muted/20">
                        <td colspan="8" class="p-6">
                          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                            <!-- Información Personal -->
                            <div>
                              <h4 class="font-semibold mb-2 text-sm">Información Personal</h4>
                              <dl class="space-y-1 text-xs">
                                <div><dt class="text-muted-foreground inline">Edad:</dt> <dd class="inline"><%= a.Edad || '-' %></dd></div>
                                <div><dt class="text-muted-foreground inline">Fecha Nac.:</dt> <dd class="inline"><%= a.FechaNacimiento ? new Date(a.FechaNacimiento).toLocaleDateString('es-MX') : '-' %></dd></div>
                                <div><dt class="text-muted-foreground inline">Género:</dt> <dd class="inline"><%= a.Genero || '-' %></dd></div>
                                <div><dt class="text-muted-foreground inline">Estado Civil:</dt> <dd class="inline"><%= a.EstadoCivil || '-' %></dd></div>
                                <div><dt class="text-muted-foreground inline">Teléfono Emergencia:</dt> <dd class="inline"><%= a.TelefonoEmergencia || '-' %></dd></div>
                              </dl>
                            </div>

                            <!-- Domicilio -->
                            <% if (a.Domicilio) { %>
                            <div>
                              <h4 class="font-semibold mb-2 text-sm">Domicilio</h4>
                              <p class="text-xs text-muted-foreground">
                                <%= a.Domicilio.Calle %> <%= a.Domicilio.NumeroExterior %><br>
                                <%= a.Domicilio.Colonia %>, CP <%= a.Domicilio.CodigoPostal %><br>
                                <%= a.Domicilio.Ciudad %>, <%= a.Domicilio.Estado %>
                              </p>
                            </div>
                            <% } %>

                            <!-- Escuela -->
                            <% if (a.EscuelaProcedencia && a.EscuelaProcedencia.Nombre) { %>
                            <div>
                              <h4 class="font-semibold mb-2 text-sm">Escuela de Procedencia</h4>
                              <dl class="space-y-1 text-xs">
                                <div><dt class="text-muted-foreground inline">Escuela:</dt> <dd class="inline"><%= a.EscuelaProcedencia.Nombre %></dd></div>
                                <div><dt class="text-muted-foreground inline">Promedio:</dt> <dd class="inline"><%= a.EscuelaProcedencia.Promedio || '-' %></dd></div>
                                <div><dt class="text-muted-foreground inline">Carrera:</dt> <dd class="inline"><%= a.EscuelaProcedencia.CarreraEstudiada || '-' %></dd></div>
                                <div><dt class="text-muted-foreground inline">Tipo:</dt> <dd class="inline"><%= a.EscuelaProcedencia.TipoEscuela || '-' %></dd></div>
                                <div><dt class="text-muted-foreground inline">Año Egreso:</dt> <dd class="inline"><%= a.EscuelaProcedencia.AnioEgreso || '-' %></dd></div>
                              </dl>
                            </div>
                            <% } %>

                            <!-- Padre -->
                            <% if (a.Padre && a.Padre.Nombre) { %>
                            <div>
                              <h4 class="font-semibold mb-2 text-sm">Padre/Tutor</h4>
                              <dl class="space-y-1 text-xs">
                                <div><dt class="text-muted-foreground inline">Nombre:</dt> <dd class="inline"><%= a.Padre.Nombre %></dd></div>
                                <div><dt class="text-muted-foreground inline">Teléfono:</dt> <dd class="inline"><%= a.Padre.Telefono || '-' %></dd></div>
                                <div><dt class="text-muted-foreground inline">Correo:</dt> <dd class="inline"><%= a.Padre.Correo || '-' %></dd></div>
                                <div><dt class="text-muted-foreground inline">Ocupación:</dt> <dd class="inline"><%= a.Padre.Ocupacion || '-' %></dd></div>
                              </dl>
                            </div>
                            <% } %>

                            <!-- Madre -->
                            <% if (a.Madre && a.Madre.Nombre) { %>
                            <div>
                              <h4 class="font-semibold mb-2 text-sm">Madre/Tutora</h4>
                              <dl class="space-y-1 text-xs">
                                <div><dt class="text-muted-foreground inline">Nombre:</dt> <dd class="inline"><%= a.Madre.Nombre %></dd></div>
                                <div><dt class="text-muted-foreground inline">Teléfono:</dt> <dd class="inline"><%= a.Madre.Telefono || '-' %></dd></div>
                                <div><dt class="text-muted-foreground inline">Correo:</dt> <dd class="inline"><%= a.Madre.Correo || '-' %></dd></div>
                                <div><dt class="text-muted-foreground inline">Ocupación:</dt> <dd class="inline"><%= a.Madre.Ocupacion || '-' %></dd></div>
                              </dl>
                            </div>
                            <% } %>

                            <!-- Info Socioeconómica -->
                            <% if (a.InfoSocioeconomica) { %>
                            <div>
                              <h4 class="font-semibold mb-2 text-sm">Información Socioeconómica</h4>
                              <dl class="space-y-1 text-xs">
                                <div><dt class="text-muted-foreground inline">Trabaja:</dt> <dd class="inline"><%= a.InfoSocioeconomica.TrabajaActualmente ? 'Sí' : 'No' %></dd></div>
                                <% if (a.InfoSocioeconomica.LugarTrabajo) { %>
                                <div><dt class="text-muted-foreground inline">Lugar:</dt> <dd class="inline"><%= a.InfoSocioeconomica.LugarTrabajo %></dd></div>
                                <% } %>
                                <div><dt class="text-muted-foreground inline">Ingreso Familiar:</dt> <dd class="inline"><%= a.InfoSocioeconomica.IngresoMensual || '-' %></dd></div>
                                <div><dt class="text-muted-foreground inline">Vivienda:</dt> <dd class="inline"><%= a.InfoSocioeconomica.TipoVivienda || '-' %></dd></div>
                                <div><dt class="text-muted-foreground inline">Transporte:</dt> <dd class="inline"><%= a.InfoSocioeconomica.TransporteUtiliza || '-' %></dd></div>
                              </dl>
                            </div>
                            <% } %>
                          </div>

                          <!-- Información Adicional -->
                          <% if (a.DiscapacidadOCondicion || a.RequiereApoyo || a.ComoSeEntero) { %>
                          <div class="mt-4 pt-4 border-t">
                            <h4 class="font-semibold mb-2 text-sm">Información Adicional</h4>
                            <dl class="grid gap-2 md:grid-cols-2 text-xs">
                              <% if (a.DiscapacidadOCondicion) { %>
                              <div><dt class="text-muted-foreground inline">Discapacidad/Condición:</dt> <dd class="inline"><%= a.DiscapacidadOCondicion %></dd></div>
                              <% } %>
                              <% if (a.RequiereApoyo) { %>
                              <div><dt class="text-muted-foreground inline">Tipo de Apoyo:</dt> <dd class="inline"><%= a.TipoApoyo || 'Sí' %></dd></div>
                              <% } %>
                              <% if (a.ComoSeEntero) { %>
                              <div><dt class="text-muted-foreground inline">¿Cómo se enteró?:</dt> <dd class="inline"><%= a.ComoSeEntero %></dd></div>
                              <% } %>
                            </dl>
                          </div>
                          <% } %>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="8" class="p-6 text-center text-muted-foreground">No hay pre-registros.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script>
    function toggleDetails(uuid) {
      const detailsRow = document.getElementById('details-' + uuid);
      if (detailsRow) {
        detailsRow.classList.toggle('hidden');
      }
    }

    document.addEventListener('DOMContentLoaded', function(){
      const searchInput = document.getElementById('searchInput');
      const tbody = document.querySelector('tbody');
      if (searchInput && tbody) {
        searchInput.addEventListener('input', function(){
          const q = this.value.toLowerCase().trim();
          tbody.querySelectorAll('tr').forEach(tr => {
            // Skip details rows
            if (tr.id && tr.id.startsWith('details-')) return;
            
            const txt = (tr.textContent || '').toLowerCase();
            const isVisible = txt.includes(q);
            tr.style.display = isVisible ? '' : 'none';
            
            // Also hide the associated details row if the main row is hidden
            const detailsRow = tr.nextElementSibling;
            if (detailsRow && detailsRow.id && detailsRow.id.startsWith('details-')) {
              if (!isVisible) {
                detailsRow.style.display = 'none';
              }
            }
          });
        });
      }
    });
  </script>
</body>
</html>
