<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=PT+Sans:wght@400;700&display=swap"
        rel="stylesheet">
    <style>
        :root {
            --background: 165 60% 97%;
            --foreground: 171 80% 10%;
            --card: 165 60% 97%;
            --card-foreground: 171 80% 10%;
            --popover: 165 60% 97%;
            --popover-foreground: 171 80% 10%;
            --primary: 171 95% 27%;
            --primary-foreground: 171 25% 95%;
            --secondary: 169 53% 90%;
            --secondary-foreground: 171 95% 27%;
            --muted: 169 53% 94%;
            --muted-foreground: 171 40% 30%;
            --accent: 169 53% 41%;
            --accent-foreground: 171 25% 98%;
            --destructive: 0 84.2% 60.2%;
            --destructive-foreground: 0 0% 98%;
            --border: 171 20% 88%;
            --input: 171 20% 88%;
            --ring: 171 95% 27%;
            --radius: 0.5rem;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: hsl(var(--muted) / 0.4);
        }

        .font-headline {
            font-family: 'PT Sans', sans-serif;
        }

        .bg-background {
            background-color: hsl(var(--background));
        }

        .bg-primary {
            background-color: hsl(var(--primary));
        }

        .text-primary {
            color: hsl(var(--primary));
        }

        .text-primary-foreground {
            color: hsl(var(--primary-foreground));
        }

        .bg-muted\/40 {
            background-color: hsl(var(--muted), 0.4);
        }

        .border-b {
            border-bottom-width: 1px;
        }

        .border-r {
            border-right-width: 1px;
        }

        .border-border {
            border-color: hsl(var(--border));
        }

        .text-muted-foreground {
            color: hsl(var(--muted-foreground));
        }

        .text-foreground {
            color: hsl(var(--foreground));
        }

        .bg-card {
            background-color: hsl(var(--card));
        }

        .bg-muted {
            background-color: hsl(var(--muted));
        }

        .text-card-foreground {
            color: hsl(var(--card-foreground));
        }

        .shadow-sm {
            box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        }

        .rounded-lg {
            border-radius: var(--radius);
        }

        .rounded-md {
            border-radius: calc(var(--radius) - 2px);
        }

        .border {
            border-width: 1px;
        }

        .badge-secondary {
            border-color: transparent;
            background-color: hsl(var(--secondary));
            color: hsl(var(--secondary-foreground));
        }

        .badge-outline {
            color: hsl(var(--foreground));
            border-color: hsl(var(--border));
        }

        /* Mobile sheet styles */
        .sheet-content {
            transform: translateX(-100%);
            transition: transform 0.3s ease-in-out;
        }

        .sheet-open .sheet-content {
            transform: translateX(0);
        }

        .sheet-overlay {
            opacity: 0;
            transition: opacity 0.3s ease-in-out;
            pointer-events: none;
        }

        .sheet-open .sheet-overlay {
            opacity: 1;
            pointer-events: auto;
        }
    </style>
</head>

<body class="antialiased">
    <div class="relative min-h-screen w-full md:flex">
        <!-- Sidebar for Desktop -->
        <%- include('./templates/left_menu.ejs', { hovered: 3 }) %>

            <!-- Main Content -->
            <div class="flex flex-col flex-1">
                <header class="flex h-14 items-center gap-4 border-b bg-background px-4 md:px-6">
                    <!-- Mobile Menu Trigger -->
                    <button id="mobile-menu-trigger" class="md:hidden p-2 -ml-2 text-muted-foreground">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                            class="h-6 w-6">
                            <line x1="4" x2="20" y1="12" y2="12" />
                            <line x1="4" x2="20" y1="6" y2="6" />
                            <line x1="4" x2="20" y1="18" y2="18" />
                        </svg>
                        <span class="sr-only">Toggle Menu</span>
                    </button>

                    <div class="flex-1">
                        <h1 class="font-semibold text-lg">Gestión de Noticias</h1>
                    </div>

                    <!-- User Dropdown -->
                    <%- include('./templates/dropdown_user.ejs') %>
                </header>

                <main class="grid flex-1 items-start gap-4 p-4 sm:px-6 md:gap-8">
                    <div class="bg-card rounded-lg border shadow-sm">
                        <div class="flex flex-col sm:flex-row items-center justify-between p-6">
                            <div>
                                <h3 class="text-xl font-headline font-semibold">Artículos y Comunicados</h3>
                                <p class="text-sm text-muted-foreground">Crea, edita y publica las noticias de la
                                    universidad.</p>
                            </div>
                            <div class="flex items-center gap-2 mt-4 sm:mt-0">
                                <div class="relative">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                        stroke-linejoin="round"
                                        class="absolute left-2.5 top-2.5 h-4 w-4 text-muted-foreground">
                                        <circle cx="11" cy="11" r="8" />
                                        <path d="m21 21-4.3-4.3" />
                                    </svg>
                                    <input type="search" id="searchInput" placeholder="Buscar por título..."
                                        class="pl-8 w-full sm:w-64 h-9 rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">
                                </div>
                                <select id="statusFilter" class="h-9 rounded-md border border-input bg-background px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
                                    <option value="all">Todos</option>
                                    <option value="published">Publicados</option>
                                    <option value="draft">Borradores</option>
                                </select>
                                <button
                                    id="button_add"
                                    class="w-full sm:w-auto mt-4 sm:mt-0 flex items-center justify-center gap-2 h-9 px-4 py-2 bg-primary text-primary-foreground hover:bg-primary/90 rounded-md text-sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                        stroke-linejoin="round" class="h-4 w-4">
                                        <path d="M5 12h14" />
                                        <path d="M12 5v14" />
                                    </svg>
                                    Nuevo Artículo
                                </button>
                            </div>
                        </div>
                        <div class="p-0">
                            <div class="overflow-x-auto overflow-visible pb-16">
                                <table class="w-full text-sm">
                                    <thead class="bg-muted/50">
                                        <tr class="border-b">
                                            <th class="p-4 text-left font-medium text-muted-foreground">Título</th>
                                            <th
                                                class="p-4 text-left font-medium text-muted-foreground hidden sm:table-cell">
                                                Autor</th>
                                            <th
                                                class="p-4 text-left font-medium text-muted-foreground hidden md:table-cell">
                                                Fecha de Publicación</th>
                                            <th
                                                class="p-4 text-left font-medium text-muted-foreground hidden sm:table-cell">
                                                Estado</th>
                                            <th class="p-4 text-right font-medium text-muted-foreground">Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-border">
                                        <% if (news && news.length > 0) { %>
                                            <% news.forEach(function(item){ %>
                                                <tr data-status="<%= item.Estado ? 'published' : 'draft' %>">
                                                    <td class="p-4 font-medium"><%= item.Titulo %></td>
                                                    <td class="p-4 hidden sm:table-cell"><%= item.Categoria || '-' %></td>
                                                    <td class="p-4 hidden md:table-cell"><%= item.Publicada_en ? new Date(item.Publicada_en).toLocaleDateString('es-MX') : '-' %></td>
                                                    <td class="p-4 hidden sm:table-cell">
                                                        <span class="text-xs font-semibold inline-block py-1 px-2.5 rounded-full <%= item.Estado ? 'badge-secondary' : 'badge-outline' %>">
                                                            <%= item.Estado ? 'Publicado' : 'Borrador' %>
                                                        </span>
                                                    </td>
                                                    <td class="p-4 text-right space-x-2">
                                                        <a href="/admin/noticias/update/<%= item.UUID %>" class="px-3 py-1 border border-input bg-background hover:bg-accent hover:text-accent-foreground rounded-md text-sm inline-block">Editar</a>
                                                        <div class="relative inline-block text-left">
                                                            <button onclick="toggleDropdown('<%= item.UUID %>')" class="px-3 py-1 border-transparent text-destructive-foreground bg-destructive hover:bg-destructive/80 rounded-md text-sm inline-flex items-center gap-1">
                                                                Opciones
                                                                <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                                                    <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                                                                </svg>
                                                            </button>
                                                            <div id="dropdown-<%= item.UUID %>" class="hidden absolute right-0 z-50 mt-2 w-72 max-h-96 overflow-y-auto origin-top-right rounded-md bg-white shadow-lg ring-1 ring-black ring-opacity-5">
                                                                <div class="py-1">
                                                                    <% if (item.Estado) { %>
                                                                        <button onclick="deactivateNews('<%= item.UUID %>')" class="text-gray-700 hover:bg-gray-100 block w-full text-left px-4 py-2 text-sm">
                                                                            <span class="flex items-center gap-2">
                                                                                <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                                                                                </svg>
                                                                                Desactivar
                                                                            </span>
                                                                        </button>
                                                                    <% } else { %>
                                                                        <button onclick="reactivateNews('<%= item.UUID %>')" class="text-green-700 hover:bg-green-50 block w-full text-left px-4 py-2 text-sm">
                                                                            <span class="flex items-center gap-2">
                                                                                <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                                                                </svg>
                                                                                Reactivar
                                                                            </span>
                                                                        </button>
                                                                    <% } %>
                                                                    <button onclick="deleteNewsPermanently('<%= item.UUID %>')" class="text-red-700 hover:bg-red-50 block w-full text-left px-4 py-2 text-sm">
                                                                        <span class="flex items-center gap-2">
                                                                            <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                                            </svg>
                                                                            Eliminar permanentemente
                                                                        </span>
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="5" class="p-8 text-center text-muted-foreground">No hay noticias registradas.</td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
    </div>

    <!-- Mobile Sidebar -->
    <div id="mobile-sheet" class="md:hidden fixed inset-0 z-40 hidden">
        <div id="mobile-sheet-overlay" class="sheet-overlay fixed inset-0 bg-black/60"></div>
        <div class="sheet-content relative flex flex-col w-64 h-full bg-background z-50">
            <div class="flex items-center justify-between border-b border-border p-4 h-14">
                <div class="flex items-center gap-2 font-semibold">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                        class="h-6 w-6">
                        <path
                            d="M4.18 4.18A2 2 0 0 0 3 6v12a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-1.18-1.82L13 2.18a2 2 0 0 0-2 0L4.18 4.18Z" />
                        <path d="M12 22V10" />
                        <path d="m17 14-5-3-5 3" />
                        <path d="M12 10v4" />
                    </svg>
                    <span>Universidad Inc</span>
                </div>
                <button id="mobile-menu-close" class="p-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                        class="h-6 w-6">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
            <nav class="flex flex-col p-2 space-y-1">
                <a href="/admin-dashboard.html"
                    class="flex items-center gap-3 rounded-lg px-3 py-2 text-muted-foreground transition-all hover:text-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                        class="h-5 w-5">
                        <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                        <polyline points="9 22 9 12 15 12 15 22" />
                    </svg>
                    Dashboard
                </a>
                <a href="/admin-informacion.html"
                    class="flex items-center gap-3 rounded-lg px-3 py-2 text-muted-foreground transition-all hover:text-primary">
                    Información General
                </a>
            </nav>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const userMenuButton = document.getElementById('user-menu-button');
            const userMenu = document.getElementById('user-menu');
            const mobileMenuTrigger = document.getElementById('mobile-menu-trigger');
            const mobileMenuClose = document.getElementById('mobile-menu-close');
            const mobileSheet = document.getElementById('mobile-sheet');
            const mobileSheetOverlay = document.getElementById('mobile-sheet-overlay');

            if (userMenuButton && userMenu) {
                userMenuButton.addEventListener('click', function (event) {
                    event.stopPropagation();
                    userMenu.classList.toggle('hidden');
                });
                document.addEventListener('click', function (event) {
                    if (!userMenu.contains(event.target) && !userMenuButton.contains(event.target)) {
                        userMenu.classList.add('hidden');
                    }
                });
            }

            function openSheet() {
                if (mobileSheet) mobileSheet.classList.remove('hidden');
                setTimeout(() => {
                    if (mobileSheet) mobileSheet.classList.add('sheet-open');
                }, 10);
            }
            function closeSheet() {
                if (mobileSheet) mobileSheet.classList.remove('sheet-open');
                setTimeout(() => {
                    if (mobileSheet) mobileSheet.classList.add('hidden');
                }, 300);
            }

            if (mobileMenuTrigger) mobileMenuTrigger.addEventListener('click', openSheet);
            if (mobileMenuClose) mobileMenuClose.addEventListener('click', closeSheet);
            if (mobileSheetOverlay) mobileSheetOverlay.addEventListener('click', closeSheet);

            document.getElementById('button_add').addEventListener('click', function () { window.location.href = '/admin/noticias/add';})

            // Search + status filter functionality
            const searchInput = document.getElementById('searchInput');
            const statusFilter = document.getElementById('statusFilter');
            const tableBody = document.querySelector('tbody');

            function applyFilters() {
                const searchTerm = (searchInput?.value || '').toLowerCase().trim();
                const status = statusFilter?.value || 'all';
                const rows = tableBody.querySelectorAll('tr');
                rows.forEach(row => {
                    const cells = row.querySelectorAll('td');
                    if (cells.length === 0) return;
                    const text = Array.from(cells).map(cell => cell.textContent.toLowerCase()).join(' ');
                    const rowStatus = row.getAttribute('data-status');
                    const matchesSearch = text.includes(searchTerm);
                    const matchesStatus = (status === 'all') || (rowStatus === status);
                    row.style.display = (matchesSearch && matchesStatus) ? '' : 'none';
                });
            }

            if (searchInput) searchInput.addEventListener('input', applyFilters);
            if (statusFilter) statusFilter.addEventListener('change', applyFilters);
            // Initial filter to ensure everything shows
            applyFilters();

            // (Acciones de noticias se manejan con funciones globales)
        });

        function toggleDropdown(uuid) {
            const dropdown = document.getElementById(`dropdown-${uuid}`);
            document.querySelectorAll('[id^="dropdown-"]').forEach(d => {
                if (d.id !== `dropdown-${uuid}`) d.classList.add('hidden');
            });
            const willShow = dropdown.classList.contains('hidden');
            dropdown.classList.toggle('hidden');
            if (willShow) {
                requestAnimationFrame(() => {
                    dropdown.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
                });
            }
        }

        document.addEventListener('click', function (event) {
            if (!event.target.closest('[onclick^="toggleDropdown"]') && !event.target.closest('[id^="dropdown-"]')) {
                document.querySelectorAll('[id^="dropdown-"]').forEach(d => d.classList.add('hidden'));
            }
        });

        function deactivateNews(uuid) {
            document.getElementById(`dropdown-${uuid}`).classList.add('hidden');
            Swal.fire({
                title: 'Desactivar noticia',
                text: 'Esta acción desactivará la noticia. ¿Continuar?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Sí, desactivar',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#0d9488',
                cancelButtonColor: '#6b7280'
            }).then(result => {
                if (!result.isConfirmed) return;
                fetch(`/admin/raw-data/noticias/deactivate-one/${uuid}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' } })
                .then(r => r.json())
                .then(data => {
                    if (data.status === 200) {
                        Swal.fire({ title: 'Desactivada', text: 'La noticia fue desactivada.', icon: 'success', timer: 1400, showConfirmButton: false }).then(() => location.reload());
                    } else {
                        Swal.fire({ title: 'Error', text: data.msg || 'No se pudo desactivar.', icon: 'error' });
                    }
                })
                .catch(() => Swal.fire({ title: 'Error', text: 'Error al desactivar la noticia', icon: 'error' }));
            });
        }

        function reactivateNews(uuid) {
            document.getElementById(`dropdown-${uuid}`).classList.add('hidden');
            Swal.fire({
                title: 'Reactivar noticia',
                text: '¿Deseas reactivar esta noticia?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Sí, reactivar',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#0d9488',
                cancelButtonColor: '#6b7280'
            }).then(result => {
                if (!result.isConfirmed) return;
                fetch(`/admin/raw-data/noticias/reactivate-one/${uuid}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' } })
                .then(r => {
                    if (!r.ok) throw new Error(`HTTP ${r.status}`);
                    return r.json();
                })
                .then(data => {
                    if (data.status === 200) {
                        Swal.fire({ title: 'Reactivada', text: 'La noticia fue reactivada.', icon: 'success', timer: 1400, showConfirmButton: false }).then(() => location.reload());
                    } else {
                        Swal.fire({ title: 'Error', text: data.msg || 'No se pudo reactivar.', icon: 'error' });
                    }
                })
                .catch(err => Swal.fire({ title: 'Error', text: 'Error al reactivar la noticia: ' + err.message, icon: 'error' }));
            });
        }

        function deleteNewsPermanently(uuid) {
            document.getElementById(`dropdown-${uuid}`).classList.add('hidden');
            Swal.fire({
                title: '¿Eliminar permanentemente?',
                html: '<p class="text-sm text-gray-600">Esta acción <strong>no se puede deshacer</strong>. La noticia será eliminada de la base de datos.</p>',
                icon: 'error',
                showCancelButton: true,
                confirmButtonText: 'Sí, eliminar permanentemente',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#dc2626',
                cancelButtonColor: '#6b7280',
                input: 'checkbox',
                inputPlaceholder: 'Entiendo que esta acción es irreversible',
                inputValidator: (result) => {
                    return !result && 'Debes confirmar que entiendes las consecuencias'
                }
            }).then(result => {
                if (!result.isConfirmed) return;
                fetch(`/admin/raw-data/noticias/delete-one/${uuid}`, { method: 'DELETE', headers: { 'Content-Type': 'application/json' } })
                .then(r => r.json())
                .then(data => {
                    if (data.status === 200) {
                        Swal.fire({ title: 'Eliminada', text: 'La noticia fue eliminada permanentemente.', icon: 'success', timer: 1400, showConfirmButton: false }).then(() => location.reload());
                    } else {
                        Swal.fire({ title: 'Error', text: data.msg || 'No se pudo eliminar.', icon: 'error' });
                    }
                })
                .catch(() => Swal.fire({ title: 'Error', text: 'Error al eliminar la noticia', icon: 'error' }));
            });
        }
    </script>
</body>

</html>