<!-- Page Header Component -->
<section class="relative py-16 md:py-20">
  <% if (typeof heroImage !== 'undefined' && heroImage && heroImage.imageUrl) { %>
    <img src="<%= heroImage.imageUrl %>" alt="<%= heroImage.description || pageTitle %>" class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-black/60"></div>
    <div class="container relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center text-white">
      <h1 class="font-headline text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
        <%= pageTitle %>
      </h1>
      <% if (pageDescription) { %>
        <p class="mt-4 max-w-3xl mx-auto text-lg md:text-xl text-white/90">
          <%= pageDescription %>
        </p>
      <% } %>
      <% if (breadcrumbs && breadcrumbs.length > 0) { %>
        <nav class="mt-6 flex justify-center" aria-label="Breadcrumb">
          <ol class="inline-flex items-center space-x-1 md:space-x-3">
            <% breadcrumbs.forEach((crumb, index) => { %>
              <li class="inline-flex items-center">
                <% if (index > 0) { %>
                  <svg class="w-3 h-3 text-white/80 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
                  </svg>
                <% } %>
                <% if (crumb.href) { %>
                  <a href="<%= crumb.href %>" class="inline-flex items-center text-sm font-medium text-white/90 hover:text-white">
                    <%= crumb.title %>
                  </a>
                <% } else { %>
                  <span class="text-sm font-medium text-white">
                    <%= crumb.title %>
                  </span>
                <% } %>
              </li>
            <% }); %>
          </ol>
        </nav>
      <% } %>
    </div>
  <% } else { %>
    <div class="absolute inset-0 bg-gradient-to-br from-primary to-accent opacity-90"></div>
    <div class="container relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="font-headline text-4xl font-bold tracking-tight text-primary-foreground sm:text-5xl md:text-6xl">
          <%= pageTitle %>
        </h1>
        <% if (pageDescription) { %>
          <p class="mt-4 max-w-3xl mx-auto text-lg text-primary-foreground/90 md:text-xl">
            <%= pageDescription %>
          </p>
        <% } %>
        <% if (breadcrumbs && breadcrumbs.length > 0) { %>
          <nav class="mt-6 flex justify-center" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-1 md:space-x-3">
              <% breadcrumbs.forEach((crumb, index) => { %>
                <li class="inline-flex items-center">
                  <% if (index > 0) { %>
                    <svg class="w-3 h-3 text-primary-foreground/60 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                      <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
                    </svg>
                  <% } %>
                  <% if (crumb.href) { %>
                    <a href="<%= crumb.href %>" class="inline-flex items-center text-sm font-medium text-primary-foreground/80 hover:text-primary-foreground">
                      <%= crumb.title %>
                    </a>
                  <% } else { %>
                    <span class="text-sm font-medium text-primary-foreground">
                      <%= crumb.title %>
                    </span>
                  <% } %>
                </li>
              <% }); %>
            </ol>
          </nav>
        <% } %>
      </div>
    </div>
  <% } %>
</section>
