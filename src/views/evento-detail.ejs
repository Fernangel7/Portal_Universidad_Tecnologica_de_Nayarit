<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= evento.titulo %> - <%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=PT+Sans:wght@400;700&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com?plugins=forms,typography"></script>
</head>
<body class="font-body antialiased bg-white">
  <div class="flex min-h-screen flex-col">
    <%- include('templates/header.ejs', navigationLinks); %>
    <main class="flex-1">
      <!-- Hero Detalle de Evento -->
      <section class="relative w-full">
        <div class="relative h-[220px] md:h-[320px]">
          <img src="<%= evento.imageUrl || 'https://images.unsplash.com/photo-1503428593586-e225b39bddfe?auto=format&fit=crop&w=1600&q=80' %>" class="absolute inset-0 h-full w-full object-cover" alt="<%= evento.titulo %>" />
          <div class="absolute inset-0 bg-gradient-to-b from-black/60 to-black/35"></div>
          <div class="relative z-10 h-full max-w-3xl mx-auto px-4 flex flex-col justify-end pb-6 text-white">
            <div class="mb-3">
              <a href="/eventos" onclick="if (history.length > 1) { event.preventDefault(); history.back(); }" class="inline-flex items-center text-sm text-white/90 hover:underline">
                <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
                Regresar a eventos
              </a>
            </div>
            <h1 class="font-headline text-3xl md:text-5xl font-bold leading-tight"><%= evento.titulo %></h1>
            <div class="mt-3 text-sm md:text-base text-white/90 flex flex-wrap gap-4">
              <span>
                <%= evento.fechaInicio ? new Date(evento.fechaInicio).toLocaleDateString('es-MX') : '' %>
                <% if (evento.fechaFin) { %> – <%= new Date(evento.fechaFin).toLocaleDateString('es-MX') %><% } %>
              </span>
              <% if (evento.ubicacion) { %><span>• <%= evento.ubicacion %></span><% } %>
            </div>
          </div>
        </div>
      </section>
      <article class="mx-auto max-w-3xl px-4 py-12">
        <h1 class="font-headline text-4xl font-bold mb-4"><%= evento.titulo %></h1>
        <div class="text-sm text-gray-500 mb-6 flex flex-wrap gap-4">
          <span><%= evento.fechaInicio ? new Date(evento.fechaInicio).toLocaleDateString('es-MX') : '' %></span>
          <% if (evento.fechaFin) { %><span>Fin: <%= new Date(evento.fechaFin).toLocaleDateString('es-MX') %></span><% } %>
          <% if (evento.ubicacion) { %><span>Ubicación: <%= evento.ubicacion %></span><% } %>
        </div>
        <% if (evento.imageUrl) { %>
          <img src="<%= evento.imageUrl %>" alt="Imagen del evento" class="rounded-lg mb-8 w-full object-cover" />
        <% } %>
        <p class="text-lg text-gray-700 mb-6"><%= evento.descripcion %></p>
        <div class="prose max-w-none"><%- evento.contenido %></div>
        <div class="mt-12">
          <button id="toggle-events-overview" type="button" class="inline-flex items-center gap-2 px-5 py-3 bg-primary text-primary-foreground rounded-lg font-medium hover:bg-primary/90 transition-colors shadow-sm">
            Ver todos los eventos
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </button>
        </div>
      </article>
      <div id="events-overview" class="fixed inset-0 bg-black/70 backdrop-blur-sm hidden z-[60] overflow-y-auto">
        <div class="mx-auto max-w-6xl px-4 py-10">
          <div class="flex items-start justify-between mb-8">
            <div>
              <h2 class="font-headline text-2xl md:text-3xl font-bold text-white">Todos los eventos</h2>
              <p class="text-white/80 mt-1 text-sm md:text-base">Explora la lista completa sin salir.</p>
            </div>
            <button id="close-events-overview" class="text-white/80 hover:text-white inline-flex items-center gap-1 text-sm">
              Cerrar
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg>
            </button>
          </div>
          <div class="grid gap-6 md:grid-cols-3" id="events-overview-grid">
            <% (allEvents || []).forEach(function(ev){ %>
              <a href="/eventos/<%= ev.slug %>" class="group rounded-lg border bg-white shadow-sm hover:shadow-md transition overflow-hidden flex flex-col">
                <div class="h-40 w-full overflow-hidden">
                  <img src="<%= ev.imageUrl || 'https://picsum.photos/seed/evento-'+ev.slug+'/400/200' %>" class="h-full w-full object-cover group-hover:scale-105 transition" />
                </div>
                <div class="p-4 flex flex-col gap-2">
                  <h3 class="font-headline font-semibold text-lg line-clamp-2"><%= ev.titulo %></h3>
                  <p class="text-sm text-gray-600 line-clamp-3"><%= ev.descripcion || '' %></p>
                  <div class="mt-auto text-xs text-gray-500 flex gap-2 items-center">
                    <span><%= ev.fechaInicio ? new Date(ev.fechaInicio).toLocaleDateString('es-MX') : '' %></span>
                    <% if (ev.ubicacion) { %><span>• <%= ev.ubicacion %></span><% } %>
                  </div>
                </div>
              </a>
            <% }) %>
          </div>
        </div>
      </div>
    </main>
    <%- include('templates/footer.ejs'); %>
  </div>
</body>
</html>
<script>
  (function(){
    const btn = document.getElementById('toggle-events-overview');
    const overlay = document.getElementById('events-overview');
    const closeBtn = document.getElementById('close-events-overview');
    if(!btn || !overlay) return;
    btn.addEventListener('click', ()=> overlay.classList.remove('hidden'));
    closeBtn?.addEventListener('click', ()=> overlay.classList.add('hidden'));
    overlay.addEventListener('click', (e)=> { if(e.target === overlay) overlay.classList.add('hidden') })
  })();
</script>
