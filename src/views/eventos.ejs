<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Eventos - <%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=PT+Sans:wght@400;700&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com?plugins=forms,typography,aspect-ratio,line-clamp"></script>
</head>
<body class="font-body antialiased bg-white">
  <div class="flex min-h-screen flex-col">
    <%- include('templates/header.ejs', navigationLinks); %>
    <main class="flex-1">
      <!-- Toolbar de vista general -->
      <div class="border-b bg-white">
        <div class="mx-auto max-w-6xl px-4 py-4 flex flex-col md:flex-row gap-3 md:items-center md:justify-between">
          <div>
            <h2 class="font-headline text-xl md:text-2xl font-semibold">Vista general de eventos</h2>
            <p class="text-sm text-gray-600">Explora eventos próximos y pasados.</p>
          </div>
          <div class="flex gap-2">
            <input id="event-search" type="text" placeholder="Buscar eventos..." class="h-10 w-56 md:w-64 rounded-md border px-3 text-sm" />
            <select id="event-filter" class="h-10 rounded-md border px-3 text-sm">
              <option value="all">Todos</option>
              <option value="upcoming">Próximos</option>
              <option value="past">Pasados</option>
            </select>
          </div>
        </div>
      </div>
      <section class="relative w-full">
        <div class="relative h-[240px] md:h-[320px]">
          <img src="https://images.unsplash.com/photo-1503428593586-e225b39bddfe?auto=format&fit=crop&w=1600&q=80" class="absolute inset-0 h-full w-full object-cover" alt="Eventos UTNAY" />
          <div class="absolute inset-0 bg-gradient-to-b from-black/55 to-black/40"></div>
          <div class="relative z-10 flex h-full items-center justify-center flex-col text-center text-white px-4">
            <nav class="mb-3 text-sm text-white/85" aria-label="Breadcrumb">
              <ol class="inline-flex items-center gap-2">
                <li><a href="/" class="hover:underline">Inicio</a></li>
                <li>•</li>
                <li class="text-white/90">Eventos</li>
              </ol>
            </nav>
            <h1 class="font-headline text-4xl md:text-5xl font-bold">Eventos</h1>
            <p class="mt-3 max-w-2xl text-white/90">Participa y mantente informado de nuestras actividades.</p>
          </div>
        </div>
      </section>
      <section class="py-12 md:py-16">
        <div class="mx-auto max-w-6xl px-4">
          <div id="events-grid" class="grid gap-8 md:grid-cols-3">
            <% if (events && events.length > 0) { %>
              <% events.forEach(function(ev){ %>
                <a href="/eventos/<%= ev.slug %>" class="event-card group rounded-lg border bg-white shadow-sm hover:shadow-md transition overflow-hidden flex flex-col"
                   data-title="<%= (ev.titulo || '').toLowerCase() %>"
                   data-date="<%= ev.fechaInicio ? new Date(ev.fechaInicio).toISOString() : '' %>">
                  <div class="h-40 w-full overflow-hidden">
                    <img src="<%= ev.imageUrl || 'https://picsum.photos/seed/evento-'+ev.slug+'/400/200' %>" class="h-full w-full object-cover group-hover:scale-105 transition" />
                  </div>
                  <div class="p-4 flex flex-col gap-2">
                    <h3 class="font-headline font-semibold text-lg line-clamp-2"><%= ev.titulo %></h3>
                    <p class="text-sm text-gray-600 line-clamp-3"><%= ev.descripcion || '' %></p>
                    <div class="mt-auto text-xs text-gray-500 flex gap-2 items-center">
                      <span><%= ev.fechaInicio ? new Date(ev.fechaInicio).toLocaleDateString('es-MX') : '' %></span>
                      <% if (ev.ubicacion) { %><span>• <%= ev.ubicacion %></span><% } %>
                    </div>
                  </div>
                </a>
              <% }) %>
            <% } else { %>
              <div class="col-span-full text-center text-gray-600 py-16">No hay eventos disponibles.</div>
            <% } %>
          </div>
        </div>
      </section>
    </main>
    <%- include('templates/footer.ejs'); %>
  </div>
  <script>
    document.addEventListener('DOMContentLoaded', function(){
      const search = document.getElementById('event-search');
      const filter = document.getElementById('event-filter');
      const grid = document.getElementById('events-grid');
      const cards = Array.from(grid.querySelectorAll('.event-card'));

      function apply(){
        const q = (search.value || '').trim().toLowerCase();
        const f = filter.value;
        const now = new Date();
        cards.forEach(card => {
          const title = card.dataset.title || '';
          const dateStr = card.dataset.date;
          let ok = true;
          if (q) ok = ok && title.includes(q);
          if (f !== 'all') {
            if (dateStr) {
              const d = new Date(dateStr);
              if (f === 'upcoming') ok = ok && d >= now;
              if (f === 'past') ok = ok && d < now;
            } else {
              // sin fecha: solo mostrar en "Todos"
              ok = false;
            }
          }
          card.style.display = ok ? '' : 'none';
        });
      }
      search.addEventListener('input', apply);
      filter.addEventListener('change', apply);
    });
  </script>
</body>
</html>
