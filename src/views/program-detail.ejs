<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= program.name %> - <%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=PT+Sans:wght@400;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            body: ['Inter', 'sans-serif'],
            headline: ['PT Sans', 'sans-serif'],
          },
          colors: {
            background: 'hsl(165 60% 97%)',
            foreground: 'hsl(171 80% 10%)',
            card: 'hsl(165 60% 97%)',
            'card-foreground': 'hsl(171 80% 10%)',
            popover: 'hsl(165 60% 97%)',
            'popover-foreground': 'hsl(171 80% 10%)',
            primary: 'hsl(171 95% 27%)',
            'primary-foreground': 'hsl(171 25% 95%)',
            secondary: 'hsl(169 53% 90%)',
            'secondary-foreground': 'hsl(171 95% 27%)',
            muted: 'hsl(169 53% 94%)',
            'muted-foreground': 'hsl(171 40% 30%)',
            accent: 'hsl(169 53% 41%)',
            'accent-foreground': 'hsl(171 25% 98%)',
            destructive: 'hsl(0 84.2% 60.2%)',
            'destructive-foreground': 'hsl(0 0% 98%)',
            border: 'hsl(171 20% 88%)',
            input: 'hsl(171 20% 88%)',
            ring: 'hsl(171 95% 27%)',
          },
          borderRadius: {
            lg: '0.5rem',
            md: 'calc(0.5rem - 2px)',
            sm: 'calc(0.5rem - 4px)',
          },
        },
      },
    }
  </script>
</head>
<body class="font-body antialiased bg-background text-foreground">
  <%- include("./templates/header.ejs", { navigationLinks: navigationLinks, title: title }) %>

  <%- include("./templates/page_header.ejs", {
    pageTitle: program.name,
    pageDescription: program.shortDescription,
    breadcrumbs: [
      { title: "Inicio", href: "/" },
      { title: "Carreras", href: "/carreras" },
      { title: program.name, href: null }
    ],
    heroImage: programHeroImage
  }) %>

  <main class="py-16 md:py-24">
    <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-3">
        <div class="lg:col-span-2">
          <div class="prose prose-lg max-w-none">
            <h2 class="font-headline">Acerca del Programa</h2>
            <p class="text-muted-foreground">
              <%= program.shortDescription %>
            </p>
          </div>

          <div class="mt-10 grid gap-6 md:grid-cols-2">
            <div class="rounded-lg border bg-card p-6">
              <h3 class="font-headline text-lg font-semibold mb-2">Campo Laboral</h3>
              <p class="text-sm text-muted-foreground">Oportunidades laborales relacionadas con el programa.</p>
            </div>
            <div class="rounded-lg border bg-card p-6">
              <h3 class="font-headline text-lg font-semibold mb-2">Competencias</h3>
              <p class="text-sm text-muted-foreground">Habilidades y competencias que desarrollarás.</p>
            </div>
          </div>
        </div>
        <aside>
          <div class="rounded-lg border bg-card p-6">
            <h3 class="font-headline text-lg font-semibold">Información Rápida</h3>
            <ul class="mt-4 space-y-2 text-sm text-muted-foreground">
              <li>Duración: TSU + Ingeniería/Licenciatura</li>
              <li>Modalidad: Escolarizada</li>
              <li>Inicio: Próximo cuatrimestre</li>
            </ul>
            <a href="#" class="mt-6 inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium h-10 px-5 bg-primary text-primary-foreground hover:bg-primary/90">
              Solicitar Información
            </a>
          </div>
        </aside>
      </div>
    </div>
  </main>

  <%- include("./templates/footer.ejs", { title: title }) %>
</body>
</html>
